{
  "include": ["../system.json"],
  "algorithm": "gmis",
  "combination_mode": "gmis_tc",
  "modules": {
    "filter_manager": "gmis_tc_filter_manager_v1",
    "estimation": "gmis_tc_estimation_module_v1",
    "state_estimator": "generic_ekf_v1"
  },
  "frames": {
    "navigation": "NED",
    "body": "FRD",
    "attitude_parameterization": "euler_zyx_roll_pitch_heading",
    "position_reference": "local_origin",
    "geodetic_origin_lla_rad_m": [0.765022974771942, -1.3870524044472416, 186.8588823955506]
  },
  "state_layout": "gmis_tc_dynamic_dd_ambiguity_euler_v1",
  "imu_model": {
    "model_id": "gmis_imu_earth_aware_v1",
    "gyro_rate_convention": "body_relative_inertial",
    "accelerometer_input": "specific_force_mps2",
    "earth_rotation_and_transport_terms": "modeled",
    "raw_body_relative_inertial_gyro_supported": true
  },
  "measurement_models": [
    "imu_raw_gyro_accel_v1",
    "dd_code_c1_v1",
    "dd_code_p2_v1",
    "dd_phase_l1_float_v1",
    "dd_phase_l2_float_v1"
  ],
  "gnss": {
    "position_frame": "ECEF_to_local_NED",
    "base_position_reference": "antenna_phase_center",
    "antenna_lever_arm_body_m": [0.0, 0.0, 0.0],
    "rtk_solution_measurements_enabled": false,
    "rtk_velocity_measurements_enabled": false
  },
  "process_noise": {
    "jerk_variance_m2ps6": [1.0, 1.0, 1.0],
    "angular_acceleration_variance_rad2ps4": [0.0001, 0.0001, 0.0001],
    "gyro_bias_rw_psd": [1e-10, 1e-10, 1e-10],
    "accel_bias_rw_psd": [1e-8, 1e-8, 1e-8]
  },
  "measurement_noise": {
    "gyro_sigma_radps": [0.005, 0.005, 0.005],
    "accel_sigma_mps2": [0.05, 0.05, 0.05],
    "rtk_position_sigma_m": [0.5, 0.5, 1.0],
    "rtk_velocity_sigma_mps": [0.2, 0.2, 0.3]
  },
  "tc": {
    "code_observables": ["C1", "P2"],
    "phase_observables": ["L1", "L2"],
    "ambiguity_mode": "float",
    "ambiguity_unit": "cycles",
    "ionosphere_reference_frequency": "L1",
    "pivot_policy": "highest_elevation_stable_until_unavailable",
    "c1_sigma_per_receiver_m": 0.5,
    "p2_sigma_per_receiver_m": 0.7,
    "l1_phase_sigma_per_receiver_m": 0.012,
    "l2_phase_sigma_per_receiver_m": 0.018,
    "ionosphere_initial_sigma_m": 10.0,
    "ambiguity_initial_sigma_cycles": 100.0,
    "ionosphere_rw_m_sqrt_s": 0.02,
    "ambiguity_rw_cycles_sqrt_s": 0.0001,
    "max_arc_gap_seconds": 2.0,
    "minimum_elevation_deg": 10.0,
    "minimum_common_satellites": 4,
    "nis_gate": 0.0,
    "nis_policy": "log_only_no_automatic_rejection"
  },
  "runtime": {
    "output_file": "../../../output/gmis_tc/gmis_tc_solution.csv",
    "innovations_file": "../../../output/gmis_tc/gnss_innovations.csv",
    "ambiguity_file": "../../../output/gmis_tc/ambiguity_states.csv",
    "initial_attitude_rph_rad": [0.0, 0.0, 0.0],
    "initial_position_sigma_m": [10.0, 10.0, 10.0],
    "initial_velocity_sigma_mps": [5.0, 5.0, 5.0],
    "initial_attitude_sigma_rad": [0.5, 0.5, 3.141592653589793],
    "initial_acceleration_sigma_mps2": [1.0, 1.0, 1.0],
    "initial_angular_rate_sigma_radps": [0.1, 0.1, 0.1],
    "initial_sensor_error_sigma": 0.1
  }
}
