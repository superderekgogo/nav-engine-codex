{
  "modules": [
    {
      "id": "runtime_status",
      "type": "status_source",
      "publish_topic": "system.events",
      "detail": "Configuration loaded; typed module bus is active."
    },
    {
      "id": "console_output",
      "type": "console_sink",
      "subscribe_topic": "system.events"
    },
    {
      "id": "dataset_summary",
      "type": "dataset_summary_sink",
      "subscribe_topic": "dataset.summary"
    },
    {
      "id": "ins_navigator",
      "type": "ins_navigator",
      "replay_imu_topic": "navigation.replay.imu",
      "snapshot_topic": "navigation.ins.snapshot",
      "feedback_topic": "navigation.ins.feedback",
      "feedback_applied_topic": "navigation.ins.feedback.applied",
      "heading_lock_topic": "navigation.heading_lock.control",
      "estimator_output_topic": "navigation.estimator.output",
      "replay_control_topic": "navigation.replay.control",
      "solution_topic": "navigation.ins"
    },
    {
      "id": "dynamic_status",
      "type": "dynamic_status",
      "subscribe_topic": "navigation.ins.snapshot",
      "publish_topic": "navigation.dynamic_status"
    },
    {
      "id": "constraint_manager",
      "type": "constraint_manager",
      "subscribe_topic": "navigation.dynamic_status",
      "publish_topic": "navigation.constraints"
    },
    {
      "id": "navigation_csv",
      "type": "navigation_csv_sink",
      "subscribe_topic": "navigation.ins",
      "file_name": "ins_solution.csv"
    },
    {
      "id": "gnss_cycle_slip_preprocessor",
      "type": "gnss_cycle_slip_preprocessor",
      "subscribe_topic": "sensor.gnss.paired",
      "publish_topic": "sensor.gnss.prepared"
    },
    {
      "id": "td_ddcp_builder",
      "type": "td_ddcp_builder",
      "subscribe_topic": "sensor.gnss.prepared",
      "publish_topic": "measurement.td_ddcp",
      "summary_topic": "measurement.td_ddcp.summary"
    },
    {
      "id": "td_ddcp_csv",
      "type": "td_ddcp_csv_sink",
      "subscribe_topic": "measurement.td_ddcp",
      "summary_topic": "measurement.td_ddcp.summary",
      "file_name": "td_ddcp_measurements.csv"
    },
    {
      "id": "rtk_solution",
      "type": "rtk_solution",
      "subscribe_topic": "sensor.gnss.prepared",
      "publish_topic": "navigation.rtk"
    },
    {
      "id": "filter_manager",
      "type": "filter_manager"
    },
    {
      "id": "estimation",
      "type": "estimation"
    },
    {
      "id": "ltc_csv",
      "type": "navigation_csv_sink",
      "subscribe_topic": "navigation.ins",
      "file_name": "ltc_solution.csv",
      "output_rate_hz": 1.0
    },
    {
      "id": "rtk_csv",
      "type": "rtk_csv_sink",
      "subscribe_topic": "navigation.rtk",
      "file_name": "rtk_solution.csv"
    },
    {
      "id": "dataset_replay",
      "type": "dataset_replay",
      "imu_topic": "sensor.imu",
      "gnss_topic": "sensor.gnss.paired",
      "summary_topic": "dataset.summary"
    }
  ]
}
